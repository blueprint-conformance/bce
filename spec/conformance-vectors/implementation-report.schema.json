{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External implementation vector report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "implementation", "vectorSet", "environment", "assessments", "evidence", "adjudication"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "revision", "release", "maintainerControlledByBce"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "release": { "type": "string", "minLength": 1 },
        "maintainerControlledByBce": { "const": false }
      }
    },
    "vectorSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "sha256"],
      "properties": {
        "apiVersion": { "const": "blueprint-conformance/v1alpha1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "environment": { "type": "object", "minProperties": 1 },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actualVerdict", "actualExitCode"],
        "properties": {
          "id": { "type": "string" },
          "actualVerdict": { "enum": ["pass", "fail", "refusal"] },
          "actualExitCode": { "type": "integer" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicRunUrl", "runOutputSha256"],
      "properties": {
        "publicRunUrl": { "type": "string", "pattern": "^https://" },
        "runOutputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewIssue"],
      "properties": {
        "status": { "enum": ["pending", "accepted", "rejected"] },
        "reviewIssue": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
