{
  "$id": "https://blueprint-conformance.github.io/bce/schemas/remediation-work-order.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "One structured remediation proposal auto-generated per violation (src/emit.ts). Every auto-generated order starts PROPOSED and advances only through the governed approval transition matrix (propose-not-apply: nothing auto-advances).",
  "properties": {
    "approvalState": {
      "enum": [
        "PROPOSED",
        "ACKNOWLEDGED",
        "APPROVED",
        "RESOLVED",
        "REJECTED"
      ],
      "type": "string"
    },
    "blueprintRef": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "constraintId": {
      "type": "string"
    },
    "evidenceRef": {
      "type": "string"
    },
    "id": {
      "description": "deterministic id: `wo:<blueprintRef>:<sha256(key)[0..16]>`",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "traceId",
    "blueprintRef",
    "constraintId",
    "severity",
    "component",
    "evidenceRef",
    "title",
    "body",
    "approvalState"
  ],
  "title": "RemediationWorkOrder",
  "type": "object"
}
