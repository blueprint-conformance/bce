{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BCE model-evaluation protected paths",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "patterns", "packagePolicy", "historyRule"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "studyId": { "type": "string", "minLength": 3 },
    "patterns": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "packagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "default"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "default": { "const": "protected-unless-task-explicitly-allows-a-non-policy-field" }
      }
    },
    "historyRule": { "type": "string", "minLength": 20 }
  }
}
