{
  "apiVersion": "blueprint-conformance/v1alpha1",
  "kind": "EngineeringBlueprint",
  "metadata": {
    "id": "configuration-feature",
    "version": "1.0.0",
    "status": "approved"
  },
  "intentRefs": [
    "pilot-policy/configuration-feature"
  ],
  "scope": {
    "repositories": [
      "pilot/configuration-microcosm"
    ]
  },
  "architecture": {
    "components": [],
    "relationships": []
  },
  "constraints": [
    {
      "id": "cache-no-console-output",
      "type": "forbiddenPattern",
      "severity": "critical",
      "path": "src/cache.mjs",
      "pattern": "console\\.(?:log|error|warn)\\s*\\("
    }
  ],
  "evidenceRequirements": [],
  "approvals": [],
  "extraction": {
    "profile": "plugin-surface",
    "paths": [
      "src/**/*.mjs"
    ],
    "minFiles": 4
  }
}
