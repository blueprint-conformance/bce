{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BCE model-evaluation treatment delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "allowedPathPatterns", "onlyAllowedArmDifferences", "mustRemainByteIdentical", "forbiddenTreatmentDifferences"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "studyId": { "type": "string", "minLength": 3 },
    "allowedPathPatterns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "onlyAllowedArmDifferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "mustRemainByteIdentical": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "forbiddenTreatmentDifferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } }
  }
}
