{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/blueprint-conformance/bce/research/adoption-attempt.schema.json",
  "title": "Local unreviewed adoption attempt event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "attemptId",
    "sequence",
    "recordedAt",
    "previousHash",
    "hash",
    "type",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "AdoptionAttemptEvent"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^(?!artifacts$)[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T"
    },
    "previousHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "type": {
      "enum": [
        "started",
        "use-recorded",
        "finished"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "participantId",
              "relationship",
              "source",
              "environment",
              "consent"
            ],
            "properties": {
              "participantId": {
                "$ref": "https://github.com/blueprint-conformance/bce/research/adoption-record.schema.json#/properties/participantId"
              },
              "relationship": {
                "$ref": "https://github.com/blueprint-conformance/bce/research/adoption-record.schema.json#/properties/relationship"
              },
              "source": {
                "$ref": "https://github.com/blueprint-conformance/bce/research/adoption-record.schema.json#/properties/source"
              },
              "environment": {
                "$ref": "https://github.com/blueprint-conformance/bce/research/adoption-record.schema.json#/properties/environment"
              },
              "consent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "storeLocally",
                  "publishRecord"
                ],
                "properties": {
                  "storeLocally": {
                    "const": true
                  },
                  "publishRecord": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "use-recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repositoryId",
              "constraintId",
              "revision",
              "blueprintRef",
              "reportEvidenceRef",
              "reportVerdict",
              "gateOutcome",
              "gateExitCode",
              "mode",
              "baselineActive",
              "gradeable",
              "gate",
              "blueprint"
            ],
            "properties": {
              "repositoryId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
              },
              "constraintId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "blueprintRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reportEvidenceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reportVerdict": {
                "enum": [
                  "pass",
                  "fail",
                  "indeterminate"
                ]
              },
              "gateOutcome": {
                "enum": [
                  "pass",
                  "violation",
                  "refusal"
                ]
              },
              "gateExitCode": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "mode": {
                "enum": [
                  "enforced",
                  "advisory"
                ]
              },
              "baselineActive": {
                "type": "boolean"
              },
              "gradeable": {
                "type": "boolean"
              },
              "gate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "ref",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^artifacts/[a-f0-9]{64}\\.json$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4194304
                  }
                }
              },
              "blueprint": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "ref",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^artifacts/[a-f0-9]{64}\\.json$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4194304
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "$ref": "https://github.com/blueprint-conformance/bce/research/adoption-record.schema.json#/properties/journey/properties/outcome"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  ]
}
